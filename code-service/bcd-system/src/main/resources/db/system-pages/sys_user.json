              },
              {
                "name": "assignRoles",
                "caption": "分配角色",
                "icon": "user",
                "location": "before",
                "visible": true,
                "isCustom": true,
                "type": "default",
                "permCode": "system:user:assignRoles",
                "onClick": "const sel = grid.getSelectedRowsData()\nif (!sel || sel.length !== 1) { api.showMessage('请勾选一行', 'warning'); return }\nconst picked = await api.openPage('page_sys_role', {}, { bizMode: 'table', title: '选择角色（可多选勾选）', width: 780, height: 520, selectMode: true })\nif (!picked) return\nconst roles = Array.isArray(picked) ? picked : [picked]\nconst r = await api.call('sysUserAssignRoles', { data: { id: sel[0].id, roleCodes: roles.map(x => x.code) } })\nif (r && r.ok) { api.showMessage('角色已分配（用户需重新登录生效）'); grid.refresh() }"
              },
              {
                "name": "resetPwd",
                "caption": "重置密码",
                "icon": "key",
                "location": "before",
                "visible": true,
                "isCustom": true,
                "type": "warning",
                "permCode": "system:user:resetPwd",
                "onClick": "const sel = grid.getSelectedRowsData()\nif (!sel || sel.length !== 1) { api.showMessage('请勾选一行', 'warning'); return }\nif (!await api.confirm('确定重置用户「' + sel[0].username + '」的密码？')) return\nconst r = await api.call('sysUserResetPwd', { data: { id: sel[0].id } })\nif (r && r.ok) { api.showMessage('新初始密码：' + (r.data && r.data.data)); grid.refresh() }"
              },
              {
                "name": "toggleStatus",
                "caption": "启用/禁用",
                "icon": "switch",
                "location": "before",
                "visible": true,
                "isCustom": true,
                "permCode": "system:user:status",
                "onClick": "const sel = grid.getSelectedRowsData()\nif (!sel || !sel.length) { api.showMessage('请勾选要操作的行', 'warning'); return }\nfor (const row of sel) {\n  const next = row.status === 'enabled' ? 'disabled' : 'enabled'\n  await api.call('sysUserChangeStatus', { data: { id: row.id, status: next } })\n}\napi.showMessage('操作完成'); grid.refresh()"
              }
