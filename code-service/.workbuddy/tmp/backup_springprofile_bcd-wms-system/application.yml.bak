server:

  port: @server.port@
param:

  url: @param.url@

  projectLog: project_log

# 解密的key

bcd:

  decode: ahbcdxfsnmdb



seata:

  enabled: false

spring:

  mvc:

    async:

      request-timeout: 300000

  application:

    name: bcd-wms-system@prefix@@envName@

  profiles:

    active: hxh

  servlet:

    multipart:

      max-file-size: 50MB

      max-request-size: 50MB

      enabled: true

logging:

  file:

    name: logs/${spring.application.name}/info.log

management:

  endpoint:

    heapdump:

      enabled: false

    gateway:

      enabled: false

skywalking:

  agent:

    enabled: true

    service-name: bcd-wms-system@prefix@@envName@

    oap-server-url: localhost:11800

logpath: logs/${spring.application.name}

